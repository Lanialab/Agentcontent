PORT=8080
# Local default. On Railway/Fly set DATABASE_PATH=/data/agentcontent.db
DATABASE_PATH=./data/agentcontent.db
OUTLIER_MULTIPLIER=2.5
SEED_ON_EMPTY=true

# Leave empty to use stubs (demo without API keys).
YOUTUBE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional Google Sheets sync. Never Apps Script. SQLite remains source of truth.
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
